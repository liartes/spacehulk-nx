From fe4a9cbb1dbce5cc3a833a13ee092dc6e9c8ec4b Mon Sep 17 00:00:00 2001
From: Liartes <liartes@users.noreply.github.com>
Date: Fri, 9 Oct 2026 14:33:49 +0200
Subject: [PATCH 3/4] libdrm_nouveau: buffer memory through overridable hooks

nouveau_bo_new takes a buffer's memory with memalign and gives it back with
free. The build now routes both through nouveau_switch_bo_alloc /
nouveau_switch_bo_free, weak and doing the same by default, so that a
program can keep GPU buffers apart from its small allocations (mixed in one
heap they fragmented it: Space Hulk port, hardware 2026-10-09).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 build_mesa32.sh | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/build_mesa32.sh b/build_mesa32.sh
index a3bc4fef603..a69388a20bf 100755
--- a/build_mesa32.sh
+++ b/build_mesa32.sh
@@ -47,6 +47,22 @@ build_drm() {
   # (pushbuf.c); bo_map_lookup was 4% of a Unity render thread (Space Hulk
   # port, hardware 2026-10-06). 1021 buckets: 4 KB a client.
   sed -i 's/^#define BO_MAP_NUM_BUCKETS 31$/#define BO_MAP_NUM_BUCKETS 1021/' "$S/source/private.h"
+  # A buffer's memory through two hooks, weak here (memalign / free, as
+  # before) and replaced by a program that keeps GPU buffers apart from its
+  # small allocations: mixed in one heap they fragmented it until a 1 MB
+  # texture found no room with 285 MB free (Space Hulk port, hardware
+  # 2026-10-09).
+  sed -i -e 's/void\* mem = memalign(0x1000, size);/void* mem = nouveau_switch_bo_alloc(size);/' \
+    -e 's/^\t\tfree(mem);$/\t\tnouveau_switch_bo_free(mem);/' \
+    -e 's/^\t\tfree(nvbo->map_addr);$/\t\tnouveau_switch_bo_free(nvbo->map_addr);/' "$S/source/nouveau.c"
+  grep -q '^void \*nouveau_switch_bo_alloc' "$S/source/nouveau.c" || cat >> "$S/source/nouveau.c" <<'HOOKS'
+
+/* the memory of a buffer object: page-aligned, a multiple of 0x1000 bytes */
+__attribute__((weak)) void *nouveau_switch_bo_alloc(size_t size) { return memalign(0x1000, size); }
+__attribute__((weak)) void nouveau_switch_bo_free(void *p) { free(p); }
+HOOKS
+  grep -q 'nouveau_switch_bo_alloc(size_t' "$S/source/private.h" || \
+    sed -i 's/^#endif$/void *nouveau_switch_bo_alloc(size_t size);\nvoid nouveau_switch_bo_free(void *p);\n\n#endif/' "$S/source/private.h"
   rm -rf "$B" && mkdir -p "$B" "$PREFIX/lib/pkgconfig" "$PREFIX/include"
   for f in "$S"/source/*.c; do
     echo "  drm: $(basename "$f")"
-- 
2.43.0


From eb61d84fa3e32506dbb229272e8c2af0b6f3e25e Mon Sep 17 00:00:00 2001
From: Liartes <liartes@users.noreply.github.com>
Date: Fri, 6 Nov 2026 14:18:09 +0100
Subject: [PATCH 4/4] build: profile-guided passes (MESA_PGO=gen|use)

MESA_PGO=gen builds an instrumented Mesa and libdrm_nouveau into
prefix-pgo-gen/; MESA_PGO=use builds them with the merged profile of
pgo-profile/ into prefix-pgo-use/. Both pass in build-pgo/: a function's
line checksum holds its file's path, generated glapi headers included.
The plain build (build/, prefix/) is unchanged.

devkitARM's libgcov has no file I/O and empty value profilers: counters
go to the gcov_info section (-fprofile-info-section) without value
profiles, and the program linking Mesa writes them as a gcov stream.

Also: libdrm's source is reset before its edits (a second run appended
the bo hooks twice), and its objects are built with relative names
(absolute ones skipped -fprofile-prefix-path).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 build.sh        |  7 ++++---
 build_mesa32.sh | 52 ++++++++++++++++++++++++++++++++++++++++++++-----
 2 files changed, 51 insertions(+), 8 deletions(-)

diff --git a/build.sh b/build.sh
index 1a0114efe8e..1b7a6be4405 100755
--- a/build.sh
+++ b/build.sh
@@ -5,7 +5,8 @@
 # Mesa is compiled against libnx32. Point LIBNX32 at an installed libnx32
 # (its prefix/ folder); a libnx32 checkout next to this one, built, is used by
 # default. Without one, the image's stock libnx32 is used.
-# Set TOOLCHAIN_IMAGE to use another image.
+# Set TOOLCHAIN_IMAGE to use another image; MESA_PGO (gen or use) is passed
+# on to build_mesa32.sh.
 set -e
 IMAGE="${TOOLCHAIN_IMAGE:-ghcr.io/vita2hos/devcontainer/vita2hos:latest}"
 HERE="$(cd "$(dirname "$0")" && pwd)"
@@ -14,7 +15,7 @@ NX=/opt/devkitpro/libnx32
 if [ -f "$LIBNX32/lib/libnx.a" ] && [ -f "$LIBNX32/include/switch.h" ]; then
   LIBNX32="$(cd "$LIBNX32" && pwd)"
   echo "build.sh: using libnx32 from $LIBNX32"
-  exec docker run --rm --platform linux/amd64 \
+  exec docker run --rm --platform linux/amd64 ${MESA_PGO:+-e MESA_PGO=$MESA_PGO} \
     -v "$HERE:/work" \
     -v "$LIBNX32/include/switch:$NX/include/switch:ro" \
     -v "$LIBNX32/include/switch.h:$NX/include/switch.h:ro" \
@@ -24,5 +25,5 @@ if [ -f "$LIBNX32/lib/libnx.a" ] && [ -f "$LIBNX32/include/switch.h" ]; then
     -w /work "$IMAGE" bash -lc "./build_mesa32.sh $*"
 fi
 echo "build.sh: no libnx32 at $LIBNX32, using the image's stock libnx32" >&2
-exec docker run --rm --platform linux/amd64 -v "$HERE:/work" -w /work "$IMAGE" \
+exec docker run --rm --platform linux/amd64 ${MESA_PGO:+-e MESA_PGO=$MESA_PGO} -v "$HERE:/work" -w /work "$IMAGE" \
   bash -lc "./build_mesa32.sh $*"
diff --git a/build_mesa32.sh b/build_mesa32.sh
index a69388a20bf..8823c60fbf8 100755
--- a/build_mesa32.sh
+++ b/build_mesa32.sh
@@ -21,9 +21,46 @@ CC=$DEVKITPRO/devkitARM/bin/arm-none-eabi-gcc
 AR=$DEVKITPRO/devkitARM/bin/arm-none-eabi-gcc-ar
 DRM_VERSION=1.0.1
 DRM_COMMIT=137265185c95cf58ce94c7afecba14f895dac2a7
-DRM_SRC=$BUILD/libdrm_nouveau-$DRM_VERSION
+DRM_SRC=$TOP/build/libdrm_nouveau-$DRM_VERSION
 step=${1:-all}
 
+# Profile-guided builds (MESA_PGO; the default build, build/ and prefix/, is
+# unchanged without it):
+#   gen  instrumented, built in build-pgo/, installed in prefix-pgo-gen/. devkitARM's
+#        libgcov has no file I/O (built without a C library), so the counters
+#        are registered in the "gcov_info" section (-fprofile-info-section)
+#        and the program that links Mesa writes them out as a gcov stream
+#        (__gcov_info_to_gcda); `gcov-tool merge-stream` turns that into the
+#        .gcda files of pgo-profile/. Its value profilers are empty too, hence
+#        -fno-profile-values: branch and call counts only.
+#   use  built with pgo-profile/ in build-pgo/ again, installed in prefix-pgo-use/.
+#        Code the training run never reached is optimized as without a profile
+#        (-fprofile-partial-training); counters several threads raced on are
+#        accepted (-fprofile-correction).
+# Both passes build in the same folder: a function's line checksum holds its
+# file's path, and the generated headers (glapi_mapi_tmp.h...) are named by
+# their absolute path in it -- from build-pgo-gen/ to build-pgo-use/, every
+# glapi stub failed with "source locations ... have changed". The profile's
+# file names are made relative to it all the same (-fprofile-prefix-path).
+# A profile from another folder still works: a mismatch of the line checksum
+# alone keeps the profile (a warning, -Wno-error=coverage-mismatch); only a
+# changed control flow ("number of counters", "control flow checksum") loses
+# it.
+PGO_DIR=$TOP/pgo-profile
+PGOFLAGS=()
+case "${MESA_PGO:-}" in
+  "") ;;
+  gen)
+    BUILD=$TOP/build-pgo PREFIX=$TOP/prefix-pgo-gen
+    PGOFLAGS=(-fprofile-generate=$PGO_DIR -fprofile-info-section=gcov_info -fno-profile-values
+              -fprofile-update=single -fprofile-prefix-path=$BUILD) ;;
+  use)
+    BUILD=$TOP/build-pgo PREFIX=$TOP/prefix-pgo-use
+    PGOFLAGS=(-fprofile-use=$PGO_DIR -fno-profile-values -fprofile-partial-training
+              -fprofile-correction -fprofile-prefix-path=$BUILD -Wno-error=coverage-mismatch) ;;
+  *) echo "MESA_PGO: gen or use" >&2; exit 1 ;;
+esac
+
 fetch_drm() {
   [ -d "$DRM_SRC" ] && return
   mkdir -p "$BUILD"
@@ -42,6 +79,9 @@ fetch_drm() {
 build_drm() {
   fetch_drm
   local S=$DRM_SRC B=$BUILD/drm
+  # the edits below start from the pristine tag every time (a second run
+  # appended the hooks twice: their grep guard never matched)
+  git -C "$S" checkout -q -- source
   # The client's bo -> pushbuf reference table: 31 buckets for the hundreds
   # of buffers a game's frame references, looked up twice per reference
   # (pushbuf.c); bo_map_lookup was 4% of a Unity render thread (Space Hulk
@@ -66,8 +106,10 @@ HOOKS
   rm -rf "$B" && mkdir -p "$B" "$PREFIX/lib/pkgconfig" "$PREFIX/include"
   for f in "$S"/source/*.c; do
     echo "  drm: $(basename "$f")"
-    $CC -g -O2 -Wall -Werror -ffunction-sections -fdata-sections $ARCH -D__SWITCH__ \
-      -I"$S/include" -I"$NX/include" -c "$f" -o "$B/$(basename "${f%.c}").o"
+    # from $BUILD with a relative object name: GCC keeps an absolute one as is
+    # in the profile's file name (no -fprofile-prefix-path stripping)
+    (cd "$BUILD" && $CC -g -O2 -Wall -Werror -ffunction-sections -fdata-sections $ARCH -D__SWITCH__ \
+      ${PGOFLAGS[@]+"${PGOFLAGS[@]}"} -I"$S/include" -I"$NX/include" -c "$f" -o "drm/$(basename "${f%.c}").o")
   done
   $AR rcs "$PREFIX/lib/libdrm_nouveau.a" "$B"/*.o
   cp -r "$S"/include/* "$PREFIX/include/"
@@ -80,8 +122,8 @@ flags() { local out=""; for a in "$@"; do out+="'$a',"; done; echo "${out%,}"; }
 mesa_setup() {
   mkdir -p "$BUILD"
   local X=$BUILD/switch32_cross.txt
-  local CARGS=($ARCH -O2 -ffunction-sections -fdata-sections -D__SWITCH__ -DHAVE_TIMESPEC_GET -I$PREFIX/include -isystem $NX/include)
-  local LARGS=($ARCH -Wl,-z,notext -specs=$NX/switch32.specs -L$PREFIX/lib -L$NX/lib -lnx)
+  local CARGS=($ARCH -O2 -ffunction-sections -fdata-sections -D__SWITCH__ -DHAVE_TIMESPEC_GET -I$PREFIX/include -isystem $NX/include ${PGOFLAGS[@]+"${PGOFLAGS[@]}"})
+  local LARGS=($ARCH -Wl,-z,notext -specs=$NX/switch32.specs -L$PREFIX/lib -L$NX/lib -lnx ${PGOFLAGS[@]+"${PGOFLAGS[@]}"})
   cat > "$X" <<EOC
 [binaries]
 c = '$CC'
-- 
2.43.0

